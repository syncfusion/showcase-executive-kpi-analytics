<?xml version="1.0" encoding="utf-8"?>
<!-- Windows App Service (IIS) routing for the React build (factory/standards/publishing-base-path.md):
     the load balancer forwards /executive-kpi-analytics/react/... with the prefix kept, while dist/ is flat.
     Prefixed files resolve to the file at the root, prefixed app paths fall back to index.html, and the
     unprefixed root works too. Linux App Service uses server.mjs instead; this file does nothing there. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Mount path to file" stopProcessing="true">
          <match url="^executive-kpi-analytics/react/(.+)$" />
          <conditions>
            <add input="{DOCUMENT_ROOT}/{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}" />
        </rule>
        <rule name="Mount path to app" stopProcessing="true">
          <match url="^executive-kpi-analytics/react(/.*)?$" />
          <action type="Rewrite" url="index.html" />
        </rule>
        <rule name="Root app fallback" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{URL}" pattern="^/healthz$" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
